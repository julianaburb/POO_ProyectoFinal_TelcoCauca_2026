   {
     "version": "2.0.0",
     "tasks": [
       {
         "label": "Compilar TelcoCauca",
         "type": "shell",
         "command": "g++",
         "args": [
           "-std=c++11",
           "-Wall",
           "-pthread",
           "*.cpp",
           "-o",
           "telcocauca.exe",
           "-lws2_32"
         ],
         "options": { "cwd": "${workspaceFolder}" },
         "group": { "kind": "build", "isDefault": true },
         "problemMatcher": ["$gcc"]
       }
     ]
   }